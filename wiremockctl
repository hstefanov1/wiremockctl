#!/usr/bin/env bash

set -euo pipefail

readonly VERSION="0.1.0"
readonly DEPENDENCIES=(podman curl jq)
readonly SETTINGS_FILE="wiremockctl.env"
readonly FOLDERS=(mappings __files disabled)
readonly COMMANDS=(version init start stop list add disable enable)
readonly SETTINGS=(WIREMOCK_IMAGE WIREMOCK_PORT WIREMOCK_TIMEOUT WIREMOCK_EDITOR)
readonly SETTINGS_DEFAULT=(
  WIREMOCK_IMAGE=docker.io/wiremock/wiremock
  WIREMOCK_PORT=8080
  WIREMOCK_TIMEOUT=30
  WIREMOCK_EDITOR=
)

# colors only on a terminal, and when NO_COLOR is not set
COLOR=0
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  COLOR=1
fi
readonly COLOR

paint() {
  if ((COLOR)); then
    printf "\033[%sm%s\033[0m\n" "$1" "$2"
  else
    printf "%s\n" "$2"
  fi
}

red() { paint "0;31" "$1"; }
blue() { paint "0;34" "$1"; }
green() { paint "0;32" "$1"; }
yellow() { paint "0;33" "$1"; }
magenta() { paint "0;35" "$1"; }
default() { paint "0" "$1"; }

label() {
  local width="${2:-20}"
  printf "%-${width}s" "$1" | tr " " "."
  printf ": "
}

error() {
  echo
  red "ERROR: ${1:-}" >&2
  log_trace
  exit 1
}

banner() {
  echo
  blue "$1"
}

title() {
  if [[ -t 1 ]]; then clear; fi

  if [[ -z $COMMAND ]]; then
    banner ".:: WIREMOCKCTL ::."
    echo
    echo "Commands:"
    echo " init      Sets up the folder structure and settings file for a new mock server."
    echo " start     Starts the WireMock server in a Podman container and loads all active mocks."
    echo " stop      Stops the WireMock server and removes the Podman container."
    echo " list      Shows all mocks, active and disabled."
    echo " add       Guides you through creating a new mock and lets you review it in your editor."
    echo " disable   Switches a mock off without deleting it."
    echo " enable    Switches a disabled mock back on."
    echo " version   Shows the installed version."
    error "Missing or unknown command"
  fi

  banner ".:: WIREMOCKCTL · $(uppercase "$COMMAND") ::."
}

cleanup() {
  local code=$?
  echo
  if ((code == 0)); then
    green "::: BASH COMPLETED :::"
  else
    red "::: BASH ABORTED :::"
  fi
  echo
  log_end "$code"
}

uppercase() {
  printf "%s" "$1" | tr "[:lower:]" "[:upper:]"
}

lowercase() {
  printf "%s" "$1" | tr "[:upper:]" "[:lower:]"
}

log_run() {
  printf "\n=== %s: run command %s ===\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$COMMAND" >>wiremockctl.log
}

log_trace() {
  local call_stack=("${FUNCNAME[@]}")
  local call_path=""
  local idx

  for ((idx = ${#call_stack[@]} - 1; idx > 0; idx--)); do
    [[ -n "$call_path" ]] && call_path+=" -> "
    call_path+="${call_stack[idx]}"
  done

  echo "CallStack: $call_path" >>wiremockctl.log
}

log_end() {
  printf "=== %s: end command %s (exit code %s) ===\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$COMMAND" "$1" >>wiremockctl.log || true
}

get_command() {
  local input cmd
  input=$(lowercase "$1")
  for cmd in "${COMMANDS[@]}"; do
    if [[ $cmd == "$input" ]]; then
      echo "$cmd"
      return
    fi
  done
}

get_setting() {
  local input="$1" key value
  while IFS="=" read -r key value || [[ -n $key ]]; do
    if [[ $key == "$input" ]]; then
      echo "$value"
      return
    fi
  done <"$SETTINGS_FILE"
}

cmd_version() {
  echo
  echo "wiremockctl $VERSION"
}

check_dependencies() {
  banner "CHECKING DEPENDENCIES"
  local dep
  for dep in "${DEPENDENCIES[@]}"; do
    label "$dep"
    if ! command -v "$dep" >/dev/null 2>&1; then
      red "MISSING"
      error "$dep not found in \$PATH"
    fi
    green "OK"
  done
}

check_structure() {
  banner "CHECKING FOLDER STRUCTURE"
  local folder
  for folder in "${FOLDERS[@]}"; do
    label "$folder"
    if [[ ! -d $folder ]]; then
      red "MISSING"
      error "$folder folder not found, run wiremockctl init"
    fi
    green "OK"
  done

  label "$SETTINGS_FILE"
  if [[ ! -f $SETTINGS_FILE ]]; then
    red "MISSING"
    error "settings file $SETTINGS_FILE not found, run wiremockctl init"
  fi
  green "OK"
}

check_settings() {
  banner "CHECKING SETTINGS"
  local setting value
  for setting in "${SETTINGS[@]}"; do
    label "$setting"
    value="$(get_setting "$setting")"
    if [[ -z $value ]]; then
      red "MISSING"
      error "setting $setting must be defined in $SETTINGS_FILE"
    fi
    green "$value"
  done
}

preflight_checks() {
  check_dependencies
  check_structure
  check_settings
}

init_folders() {
  local folder
  for folder in "${FOLDERS[@]}"; do
    label "$folder"
    if [[ ! -d $folder ]]; then
      if mkdir "$folder"; then
        green "CREATED"
      else
        red "FAILED"
        error "failed to create folder $(pwd)/$folder"
      fi
    else
      default "EXISTS"
    fi
  done
}

init_settings() {
  label "$SETTINGS_FILE"
  if [[ ! -f $SETTINGS_FILE ]]; then
    if ! printf "%s\n" "${SETTINGS_DEFAULT[@]}" >"$SETTINGS_FILE"; then
      red "FAILED"
      error "failed to create settings file $(pwd)/$SETTINGS_FILE"
    fi
    green "CREATED"
  else
    default "EXISTS"
  fi

  if [[ -z "$(get_setting "WIREMOCK_EDITOR")" ]]; then
    echo
    echo "Next step: set WIREMOCK_EDITOR in $SETTINGS_FILE"
  fi
}

cmd_init() {
  banner "CREATING FOLDER STRUCTURE"
  init_folders
  init_settings
}

longest_name() {
  local file name max=0
  for file in "$@"; do
    [[ -e $file ]] || continue
    name="$(basename "$file")"
    if ((${#name} > max)); then
      max=${#name}
    fi
  done
  echo "$max"
}

get_width() {
  local width
  width=$(($(longest_name mappings/*.json disabled/*.json) + 3))
  if ((width < 20)); then width=20; fi
  echo "$width"
}

describe_mock() {
  local file="$1"
  if ! jq -e . "$file" >/dev/null 2>&1; then
    red "INVALID JSON"
    return
  fi

  if jq -e 'type == "object" and has("mappings")' "$file" >/dev/null; then
    red "MULTIPLE MAPPINGS"
    return
  fi

  if ! jq -e '(.request | type) == "object" and (.response | type) == "object"' "$file" >/dev/null 2>&1; then
    red "UNEXPECTED FORMAT"
    return
  fi

  jq -r '
    "\(.request.method // "-") " +
    "\(.request.url // .request.urlPath // .request.urlPattern // .request.urlPathPattern // "-") -> " +
    "\(.response.status // .response.fault // "-")"
  ' "$file" 2>/dev/null || red "UNEXPECTED FORMAT"
}

list_folder() {
  local folder="$1" width="$2" file count=0
  for file in "$folder"/*.json; do
    [[ -e $file ]] || continue
    label "$(basename "$file")" "$width"
    describe_mock "$file"
    count=$((count + 1))
  done
  if ((count == 0)); then
    echo "NONE"
  fi
}

cmd_list() {
  local width
  width="$(get_width)"

  banner "ACTIVE MOCKS"
  list_folder "mappings" "$width"

  banner "DISABLED MOCKS"
  list_folder "disabled" "$width"
}

server_is_up() {
  local port code
  port="$(get_setting WIREMOCK_PORT)"
  code="$(curl -s -o /dev/null -w "%{http_code}" --max-time 2 "http://localhost:${port}/__admin/health" || true)"
  [[ $code == "200" ]]
}

abort_if_server_running() {
  label "server"
  if server_is_up; then
    red "RUNNING"
    error "server already running on port $(get_setting WIREMOCK_PORT)"
  fi
  green "NOT RUNNING"
}

container_name() {
  local folder
  folder="$(basename "$PWD")"
  printf "wiremockctl-%s" "$(printf "%s" "$folder" | tr -c "A-Za-z0-9_.-" "-")"
}

remove_container() {
  local name="$1"
  podman rm -f "$name" >>wiremockctl.log 2>&1 || true
}

run_container() {
  local name="$1" port image
  port="$(get_setting WIREMOCK_PORT)"
  image="$(get_setting WIREMOCK_IMAGE)"

  label "container_stale"
  if podman container exists "$name"; then
    remove_container "$name"
    yellow "REMOVED"
  else
    green "NONE"
  fi

  label "container_fresh"
  if ! podman run -d --name "$name" \
    -p "$port" \
    -v "$PWD/__files:/home/wiremock/__files" \
    "$image" >>wiremockctl.log 2>&1; then
    red "FAILED"
    error "failed to start container $name, see wiremockctl.log"
  fi
  green "STARTED"
}

wait_until_ready() {
  local name="$1" limit waited=0
  limit="$(get_setting WIREMOCK_TIMEOUT)"

  label "readiness"
  until server_is_up; do
    if ((waited >= limit)); then
      red "TIMEOUT"
      podman logs "$name" >>wiremockctl.log 2>&1 || true
      remove_container "$name"
      error "server not ready after ${limit}s, see wiremockctl.log"
    fi
    sleep 1
    waited=$((waited + 1))
  done
  green "READY"
}

load_mock() {
  local container="$1" file="$2" width="$3" port response code body message
  port="$(get_setting WIREMOCK_PORT)"

  label "$(basename "$file")" "$width"
  response="$(curl -s -w "\n%{http_code}" -X POST \
    "http://localhost:${port}/__admin/mappings" \
    -H "Content-Type: application/json" \
    --data-binary @"$file" || true)"
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"

  if [[ $code == "201" ]]; then
    green "OK"
    return
  fi

  red "REJECTED"
  message="$(printf "%s" "$body" | jq -r '
    .errors[0]
    | (if .source.pointer then .source.pointer + ": " else "" end)
      + (.detail | split("\n")[0])' 2>>wiremockctl.log || true)"
  remove_container "$container"
  error "$(basename "$file"): ${message:-HTTP $code}"
}

load_mocks() {
  local container="$1" count=0 file width
  width="$(get_width)"

  for file in mappings/*.json; do
    [[ -e $file ]] || continue
    load_mock "$container" "$file" "$width"
    count=$((count + 1))
  done

  if ((count == 0)); then
    echo "NONE"
  fi
}

cmd_start() {
  local container
  container="$(container_name)"

  banner "STARTING SERVER"
  abort_if_server_running
  run_container "$container"
  wait_until_ready "$container"

  banner "LOADING MOCKS"
  load_mocks "$container"
}

trap cleanup EXIT

# setup user command if any
COMMAND="$(get_command "${1:-}")"
readonly COMMAND

# run preflight checks
log_run
title
if [[ $COMMAND != "init" && $COMMAND != "version" ]]; then
  preflight_checks
  if [[ -t 1 ]]; then
    echo
    echo -n "Initializing: $COMMAND "
    sleep 1.5
    title
  fi
fi

# run command
case "$COMMAND" in
  "version")
    cmd_version
    ;;
  "init")
    cmd_init
    ;;
  "list")
    cmd_list
    ;;
  "start")
    cmd_start
    ;;
  *)
    error "$COMMAND is not implemented yet"
    ;;
esac
