#!/usr/bin/env bash

set -euo pipefail

if [[ -t 1 ]]; then clear; fi

red() { printf "\033[1;31m%s\033[0m\n" "$1"; }
blue() { printf "\033[1;34m%s\033[0m\n" "$1"; }
green() { printf "\033[0;32m%s\033[0m\n" "$1"; }
yellow() { printf "\033[1;33m%s\033[0m\n" "$1"; }
magenta() { printf "\033[0;35m%s\033[0m\n" "$1"; }
default() { printf "\033[0m%s\033[0m\n" "$1"; }

label() {
  local str="${1// /.}"
  local dots="...................."
  printf '%s%s: ' "$str" "${dots:${#str}}"
}

error() {
  if [[ "$1" =~ ^[Ff]ailed ]]; then
    red "error"
  fi
  echo
  red "ERROR: $1"
  exit 1
}

banner() {
  echo
  blue "$1"
}

select_option() {
  local options
  options=$(echo "$1" | grep -o '\[[^]]\]' | tr -d '[]')
  options=$(echo "$options" | tr '[:upper:]' '[:lower:]')

  local user_input
  while true; do
    read -rn1 -p "$(magenta "$1 ")" user_input
    user_input=$(echo "$user_input" | tr '[:upper:]' '[:lower:]')

    [[ -z "$user_input" ]] && continue # skip if user just pressed Enter (empty input)

    echo
    if [[ "$options" == *"$user_input"* ]]; then
      OPTION="$user_input"
      break
    fi
  done
}

prompt_input() {
  read -rp "$(magenta "$1 ")"
  echo "$REPLY"
}

enforce_local_invocation() {
  # Enforces that the script is invoked from its own directory using ./
  # Args:
  #   none
  if [[ "$(dirname "$0")" != "." ]]; then
    echo
    red "ERROR: Running this script by path is not allowed."
    red "       Instead, run the command:"
    echo
    local path
    path="$(dirname "$0")"
    if [[ "$path" == *\\* ]] || [[ "$path" =~ ^[A-Za-z]: ]]; then
      path="$(echo "$path" | sed 's|\\|/|g; s|^\([A-Za-z]\):|/\L\1|')"
    fi
    red "       cd \"$path\" && ./$(basename "$0")"
    echo
    red "::: BASH ABORTED :::"
    echo
    read -rp "Press any key to exit..."
    exit 1
  fi
}

on_exit() {
  local code=$?
  echo
  if ((code == 0)); then
    green "::: BASH COMPLETED :::"
  else
    red "::: BASH ABORTED :::"
  fi
  echo
}

trap on_exit EXIT
banner ".:: MY TITLE ::."
label "hello world"
green "ok"
