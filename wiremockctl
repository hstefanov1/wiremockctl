#!/usr/bin/env bash

set -euo pipefail

readonly VERB_ARG="${1:-}"
readonly FILE_ARG="${2:-}"

readonly VERSION="0.1.0"
readonly DEPENDENCIES=(podman curl jq)
readonly LOG_FILE="wiremockctl.log"
readonly SETTINGS_FILE="wiremockctl.env"
readonly FOLDERS=(mappings __files disabled)
readonly COMMANDS=(version init start stop list add disable enable)
readonly SETTINGS=(WIREMOCK_IMAGE WIREMOCK_PORT WIREMOCK_TIMEOUT WIREMOCK_EDITOR)
readonly SETTINGS_DEFAULT=(
  WIREMOCK_IMAGE=docker.io/wiremock/wiremock
  WIREMOCK_PORT=8080
  WIREMOCK_TIMEOUT=30
  WIREMOCK_EDITOR=
)

# prevent git bash (msys) from automatically converting paths passed to podman
export MSYS_NO_PATHCONV=1

# colors only on a terminal, and when NO_COLOR is not set
COLOR=0
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  COLOR=1
fi
readonly COLOR

log() {
  { printf "%s %s: %s\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$1" "$2" >>"$LOG_FILE"; } 2>/dev/null || true
}

log_info() {
  log "INFO" "$1"
}

log_warn() {
  log "WARN" "$1"
}

log_error() {
  log "ERROR" "$1"
}

log_run() {
  { printf "====== Run [%s] ======\n" "$VERB_ARG" >>"$LOG_FILE"; } 2>/dev/null || true
}

log_end() {
  { printf "====== End [%s] ======\n\n" "$VERB_ARG" >>"$LOG_FILE"; } 2>/dev/null || true
}

log_stack() {
  local stack=("${FUNCNAME[@]}")
  local path=""
  local idx
  for ((idx = ${#stack[@]} - 1; idx > 0; idx--)); do
    [[ -n "$path" ]] && path+=" -> "
    path+="${stack[idx]}"
  done
  log_error "Call stack [$path]"
}

paint() {
  if ((COLOR)); then
    printf "\033[%sm%s\033[0m\n" "$1" "$2"
  else
    printf "%s\n" "$2"
  fi
}

red() { paint "0;31" "$1"; }
blue() { paint "0;34" "$1"; }
green() { paint "0;32" "$1"; }
yellow() { paint "0;33" "$1"; }
magenta() { paint "0;35" "$1"; }
default() { paint "0" "$1"; }

label() {
  local width="${2:-20}"
  printf "%-${width}s" "$1" | tr " " "."
  printf ": "
}

error() {
  local message="$1"
  echo
  red "ERROR: $message" >&2
  log_error "$message"
  log_stack
  exit 1
}

banner() {
  echo
  blue "$1"
}

cleanup() {
  local code=$?

  echo
  if ((code == 0)); then
    log_info "Exit code $code"
    green "::: BASH COMPLETED :::"
  else
    if ((code > 1)); then
      log_error "Failed bash command '$BASH_COMMAND'"
    fi
    log_error "Exit code $code"
    red "::: BASH ABORTED :::"
  fi
  echo

  log_end
}

uppercase() {
  printf "%s" "$1" | tr "[:lower:]" "[:upper:]"
}

lowercase() {
  printf "%s" "$1" | tr "[:upper:]" "[:lower:]"
}

get_cmd() {
  local cmd input
  input=$(lowercase "$VERB_ARG")
  for cmd in "${COMMANDS[@]}"; do
    if [[ $cmd == "$input" ]]; then
      echo "$cmd"
      return
    fi
  done
}

require_cmd() {
  if [[ -t 1 ]]; then clear; fi

  if [[ -z $COMMAND ]]; then
    banner ".:: WIREMOCKCTL ::."
    echo
    echo "Commands:"
    echo " init      Sets up the folder structure and settings file for a new mock server."
    echo " start     Starts the WireMock server in a Podman container and loads all active mocks."
    echo " stop      Stops the WireMock server and removes the Podman container."
    echo " list      Shows all mocks, active and disabled."
    echo " add       Guides you through creating a new mock and lets you review it in your editor."
    echo " disable   Switches a mock off without deleting it."
    echo " enable    Switches a disabled mock back on."
    echo " version   Shows the installed version."
    if [[ -n "$VERB_ARG" ]]; then
      error "Unknown command '$VERB_ARG'"
    else
      error "Missing command"
    fi
  fi

  banner ".:: WIREMOCKCTL · $(uppercase "$COMMAND") ::."
}

get_setting() {
  local input="$1" key value
  while IFS="=" read -r key value || [[ -n $key ]]; do
    if [[ $key == "$input" ]]; then
      echo "$value"
      return
    fi
  done <"$SETTINGS_FILE"
}

cmd_version() {
  echo
  echo "wiremockctl $VERSION"
}

check_dependencies() {
  banner "CHECKING DEPENDENCIES"
  local dep
  for dep in "${DEPENDENCIES[@]}"; do
    label "$dep"
    if ! command -v "$dep" >/dev/null 2>&1; then
      red "MISSING"
      error "Command '$dep' not found in \$PATH"
    fi
    green "OK"
  done
}

check_structure() {
  banner "CHECKING FOLDER STRUCTURE"
  local folder
  for folder in "${FOLDERS[@]}"; do
    label "$folder"
    if [[ ! -d $folder ]]; then
      red "MISSING"
      error "Folder '$folder' not found, run wiremockctl init"
    fi
    green "OK"
  done

  label "$SETTINGS_FILE"
  if [[ ! -f $SETTINGS_FILE ]]; then
    red "MISSING"
    error "File '$SETTINGS_FILE' not found, run wiremockctl init"
  fi
  green "OK"
}

check_settings() {
  banner "CHECKING SETTINGS"
  local setting value
  for setting in "${SETTINGS[@]}"; do
    label "$setting"
    value="$(get_setting "$setting")"
    if [[ -z $value ]]; then
      red "MISSING"
      error "Configuration '$setting' missing in settings file '$SETTINGS_FILE'"
    fi
    green "$value"
  done
}

preflight_checks() {
  log_info "Preflight checks"
  check_dependencies
  check_structure
  check_settings
  log_info "Preflight checks passed"
}

init_folders() {
  local folder
  for folder in "${FOLDERS[@]}"; do
    label "$folder"
    if [[ ! -d $folder ]]; then
      if mkdir "$folder"; then
        green "CREATED"
      else
        red "FAILED"
        error "Failed to create folder '$(pwd)/$folder'"
      fi
    else
      default "EXISTS"
    fi
  done
}

init_settings() {
  label "$SETTINGS_FILE"
  if [[ ! -f $SETTINGS_FILE ]]; then
    if ! printf "%s\n" "${SETTINGS_DEFAULT[@]}" >"$SETTINGS_FILE"; then
      red "FAILED"
      error "Failed to create settings file '$(pwd)/$SETTINGS_FILE'"
    fi
    green "CREATED"
  else
    log_info "Settings file already exists (configs will be checked later)"
    default "EXISTS"
  fi

  if [[ -z "$(get_setting "WIREMOCK_EDITOR")" ]]; then
    log_warn "Configuration WIREMOCK_EDITOR is missing. Please set it."
    echo
    yellow "Next step: set your preferred WIREMOCK_EDITOR in $SETTINGS_FILE"
  fi
}

cmd_init() {
  banner "CREATING FOLDER STRUCTURE"
  log_info "Working directory is '$(pwd)'"
  init_folders
  init_settings
}

longest_name() {
  local file name max=0
  for file in "$@"; do
    [[ -e $file ]] || continue
    name="$(basename "$file")"
    if ((${#name} > max)); then
      max=${#name}
    fi
  done
  echo "$max"
}

get_width() {
  local width
  width=$(($(longest_name mappings/*.json disabled/*.json) + 3))
  if ((width < 20)); then width=20; fi
  echo "$width"
}

describe_mock() {
  local file="$1" output

  # ensure the file contains valid json
  output=$(jq empty "$file" 2>&1) || {
    log_error "File '$file' is not a valid json; $output"
    red "INVALID JSON"
    return
  }

  # check whether the file contains a mappings array, as only single-mapping files are supported
  if jq -e 'type == "object" and has("mappings")' "$file" >/dev/null; then
    log_error "File '$file' contains multiple mappings, but only single-mapping is supported"
    red "MULTIPLE MAPPINGS"
    return
  fi

  # validate that the mapping contains valid request and response objects
  if ! jq -e '(.request | type) == "object" and (.response | type) == "object"' "$file" >/dev/null 2>&1; then
    log_error "File '$file' contains unexpected format, see wiremockctl ln.$((LINENO))"
    red "UNEXPECTED FORMAT"
    return
  fi

  # extracts and prints the mapping fields
  jq -r '
    "\(.request.method // "-") " +
    "\(.request.url // .request.urlPath // .request.urlPattern // .request.urlPathPattern // "-") -> " +
    "\(.response.status // .response.fault // "-")"
  ' "$file" 2>/dev/null || {
    log_error "File '$file' contains unexpected format, see wiremockctl ln.$((LINENO))"
    red "UNEXPECTED FORMAT"
  }
}

list_folder() {
  local folder="$1" width="$2" file count=0
  for file in "$folder"/*.json; do
    [[ -e $file ]] || continue
    label "$(basename "$file")" "$width"
    describe_mock "$file"
    count=$((count + 1))
  done
  if ((count == 0)); then
    echo "NONE"
  fi
}

cmd_list() {
  local width
  width="$(get_width)"
  log_info "Working directory is '$(pwd)'"

  banner "ACTIVE MOCKS"
  log_info "Listing folder 'mappings'"
  list_folder "mappings" "$width"

  banner "DISABLED MOCKS"
  log_info "Listing folder 'disabled'"
  list_folder "disabled" "$width"
}

server_is_up() {
  local port code
  port="$(get_setting WIREMOCK_PORT)"
  code="$(curl -s -o /dev/null -w "%{http_code}" --max-time 2 "http://localhost:${port}/__admin/health" || true)"
  [[ $code == "200" ]]
}

abort_if_server_running() {
  label "Server"
  if server_is_up; then
    red "ALREADY RUNNING"
    error "Server already running on port $(get_setting WIREMOCK_PORT)"
  fi
  green "NOT RUNNING"
}

container_name() {
  local folder
  folder="$(basename "$PWD")"
  printf "wiremockctl-%s" "$(printf "%s" "$folder" | tr -c "A-Za-z0-9_.-" "-")"
}

remove_container() {
  local name="$1"
  podman rm -f "$name" >/dev/null 2>&1 || true
}

run_container() {
  local name="$1"

  label "Container"
  if podman container exists "$name"; then
    log_info "Removing container '$name'"
    remove_container "$name"
  fi

  local port image volume output
  port="$(get_setting WIREMOCK_PORT)"
  image="$(get_setting WIREMOCK_IMAGE)"
  volume="$PWD/__files:/home/wiremock/__files"
  log_info "Container configurations:"
  log_info "Port=$port"
  log_info "Name='$name'"
  log_info "Image='$image'"
  log_info "Volume='$volume'"

  log_info "Starting container"
  if ! output=$(podman run -d \
    --name "$name" \
    -p "$port:8080" \
    -v "$volume" \
    "$image" --disable-banner 2>&1); then
    red "FAILED STARTING"
    log_error "Container $output"
    error "Failed to start container '$name', see $LOG_FILE"
  fi
  log_info "Container started: $output"
  green "STARTED"
}

wait_until_ready() {
  local name="$1" limit waited=0
  limit="$(get_setting WIREMOCK_TIMEOUT)"

  label "Readiness"
  log_info "Waiting for server to become ready"
  until server_is_up; do
    if ((waited >= limit)); then
      red "TIMEOUT"
      log_error "Server readiness timeout. Container logs:"
      podman logs "$name" >>"$LOG_FILE" 2>&1 || true
      remove_container "$name"
      error "Server did not become ready within ${limit}s, see $LOG_FILE"
    fi
    sleep 1
    waited=$((waited + 1))
  done
  green "HEALTHY"
  log_info "Wiremock server is ready"
}

load_mock() {
  local container="$1" file="$2" width="$3"
  local port response code body message

  label "$(basename "$file")" "$width"

  port="$(get_setting WIREMOCK_PORT)"
  response="$(curl -s -w "\n%{http_code}" -X POST \
    "http://localhost:${port}/__admin/mappings" \
    -H "Content-Type: application/json" \
    --data-binary @"$file" || true)"
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"

  if [[ $code == "201" ]]; then
    green "OK"
    return
  fi

  # something went wrong
  # extract errror message
  message="$(printf "%s" "$body" | jq -r '
    .errors[0]
    | (if .source.pointer then .source.pointer + ": " else "" end)
      + (.detail | split("\n")[0])' || true)"
  log_error "HTTP $code: ${message:-no message}"
  remove_container "$container"

  red "REJECTED"
  error "File '$(basename "$file")' was rejected, see $LOG_FILE"
}

load_mocks() {
  local count container width file
  count=0
  container="$1"
  width="$(get_width)"

  log_info "Loading mocks"
  for file in mappings/*.json; do
    [[ -e $file ]] || continue
    load_mock "$container" "$file" "$width"
    count=$((count + 1))
  done
  log_info "Successfully loaded $count mocks"

  if ((count == 0)); then
    echo "NONE"
  else
    echo
    magenta "WireMock: http://localhost:$(get_setting WIREMOCK_PORT)/__admin/mappings"
  fi
}

cmd_start() {
  local container
  container="$(container_name)"
  log_info "Working directory is '$(pwd)'"

  banner "STARTING SERVER"
  abort_if_server_running
  run_container "$container"
  wait_until_ready "$container"

  banner "LOADING MOCKS"
  load_mocks "$container"
}

stop_container() {
  local name="$1" output

  label "Container"
  if ! podman container exists "$name"; then
    log_info "Container '$name' not found, nothing to stop"
    default "NOT FOUND"
    return
  fi

  log_info "Stopping container '$name'"
  if ! output=$(podman stop "$name" 2>&1); then
    red "FAILED STOPPING"
    log_error "Container $output"
    error "Failed to stop container '$name', see $LOG_FILE"
  fi

  log_info "Removing container '$name'"
  if ! output=$(podman rm "$name" 2>&1); then
    red "FAILED REMOVING"
    log_error "Container $output"
    error "Failed to remove container '$name', see $LOG_FILE"
  fi
  green "STOPPED"
}

cmd_stop() {
  local container
  container="$(container_name)"
  log_info "Working directory is '$(pwd)'"

  banner "STOPPING SERVER"
  stop_container "$container"
}

find_mocks() {
  local folder="$1" prefix="$2"

  local lower_prefix
  lower_prefix="$(lowercase "$prefix")"

  log_info "Searching mocks in '$folder' with prefix '${lower_prefix}'"
  local file name
  for file in "$folder"/*.json; do
    [[ -e $file ]] || continue
    name="$(lowercase "$(basename "$file")")"
    if [[ $name == "$lower_prefix"* ]]; then
      echo "$file"
    fi
  done
}

move_mocks() {
  local from="$1" to="$2" status="$3"

  local matches
  matches="$(find_mocks "$from" "$FILE_ARG")"
  if [[ -z $matches ]]; then
    error "No mocks in '$from' starting with '$FILE_ARG'"
  fi

  local match_count file name conflicts=""
  match_count=$(printf '%s\n' "$matches" | wc -l)
  log_info "Found $match_count mocks... Checking for duplicates"
  while IFS= read -r file; do
    name="$(basename "$file")"
    if [[ -e $to/$name ]]; then
      [[ -n "$conflicts" ]] && conflicts+=", "
      conflicts+="'$name'"
    fi
  done <<<"$matches"
  if [[ -n $conflicts ]]; then
    error "Folder '$to' already contains $conflicts"
  fi

  log_info "No duplicates! Moving $match_count mocks"
  local width
  width="$(get_width)"
  while IFS= read -r file; do
    label "$(basename "$file")" "$width"
    mv -- "$file" "$to/"
    green "$status"
  done <<<"$matches"
  log_info "Successfully moved from '$from' to '$to'"
}

reset_mocks() {
  local port
  port="$(get_setting WIREMOCK_PORT)"

  label "Reset"
  local code
  code="$(curl -s -o /dev/null -w "%{http_code}" -X POST "http://localhost:${port}/__admin/mappings/reset" || true)"
  if [[ $code == "200" ]]; then
    green "OK"
    return
  fi
  red "FAILED"

  local name
  name="$(container_name)"
  log_error "Removing container '$name'... Container logs:"
  podman logs "$name" >>"$LOG_FILE" 2>&1 || true
  remove_container "$name"
  error "Failed to reset mocks (HTTP $code), see $LOG_FILE"
}

reload_mocks() {
  if ! server_is_up; then
    log_info "Server not running, nothing to reload"
    return
  fi

  banner "CLEARING MOCKS"
  reset_mocks

  banner "LOADING MOCKS"
  load_mocks "$(container_name)"
}

toggle_mocks() {
  if ((${#FILE_ARG} < 3)); then
    error "Name must have at least 3 characters (got '$FILE_ARG')"
  fi

  local from="$1" to="$2" status="$3"
  log_info "Working directory is '$(pwd)'"

  banner "MOVING MOCKS"
  move_mocks "$from" "$to" "$status"
  reload_mocks
}

cmd_disable() {
  toggle_mocks "mappings" "disabled" "DISABLED"
}

cmd_enable() {
  toggle_mocks "disabled" "mappings" "ENABLED"
}

trap cleanup EXIT

log_run

# setup user command if any
COMMAND="$(get_cmd)"
readonly COMMAND

# start
require_cmd

# run preflight checks
if [[ $COMMAND != "init" && $COMMAND != "version" ]]; then
  preflight_checks
  if [[ -t 1 ]]; then
    echo
    echo -n "Initializing: $COMMAND "
    sleep 1
    require_cmd
  fi
fi

# run command
case "$COMMAND" in
  "version")
    cmd_version
    ;;
  "init")
    cmd_init
    ;;
  "list")
    cmd_list
    ;;
  "start")
    cmd_start
    ;;
  "stop")
    cmd_stop
    ;;
  "disable")
    cmd_disable
    ;;
  "enable")
    cmd_enable
    ;;
  *)
    error "Command '$COMMAND' not implemented"
    ;;
esac
